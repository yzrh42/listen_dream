<div class="flex flex-grow mb-10 items-center justify-center">
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4">
        <legend class="fieldset-legend">Sign up</legend> 

        <label class="label">Email</label>
        <%= f.email_field :email, class: "input", placeholder: "Email", autofocus: true, autocomplete: "email" %>

        <label class="label">Password</label>
        <%= f.password_field :password, class: "input", placeholder: "Password", autocomplete: "current-password" %>

        <label class="label">確認用Password</label>
        <%= f.password_field :password, class: "input", placeholder: "Password", autocomplete: "current-password" %>

        <div class="mt-4">
          <%= f.submit "登録", class: 'btn btn-neutral w-full' %>
        </div>
    </fieldset>
  <% end %>
</div>