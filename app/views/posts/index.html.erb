<div class="relative flex flex-col items-center mb-10 flex-grow">

  <!-- タイトルを右上に配置 -->
  <h1 class="absolute top-0 left-0 text-2xl font-bold m-4">変な夢共有</h1>

  <div class="mt-16 mb-0 flex gap-4">
    <%= link_to "投稿日順", posts_path(sort: "created_at"),
      class: "btn btn-sm #{params[:sort] != 'date' ? 'btn-primary' : 'btn-outline'}" %>

    <%= link_to "日付順", posts_path(sort: "date"),
      class: "btn btn-sm #{params[:sort] == 'date' ? 'btn-primary' : 'btn-outline'}" %>
  </div>

  <!-- 投稿カード一覧 -->
  <div class="mt-10 flex flex-col items-center">
    <% @posts.each do |post| %>
      <div class="card bg-base-100 w-96 shadow-sm mb-6">
        <div class="card-body">
          <p class="text-right text-sm text-gray-500">
            <%= post.date.strftime("%Y年%m月%d日") %>
          </p>
          <% if post.image? %>
            <div class="mt-2">
                <%= image_tag post.image.url, class: "w-full rounded" %>
            </div>
          <% end %>
          <p class="text-left mt-2">
            <%= post.body %>
          </p>

          <% if post.user == current_user %>
            <div class="mt-4 flex justify-end gap-2">
                <%= link_to '編集', edit_post_path(post), class: 'btn btn-primary btn-sm' %>
                <%= link_to '削除', post_path(post), 
                    class: 'btn btn-secondary btn-sm', 
                    data: { 
                        turbo_method: :delete,
                        turbo_confirm: '本当に削除しますか？' } %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>