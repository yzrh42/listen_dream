<header>
    <div class="navbar bg-neutral text-neutral-content">
        <div class="flex-1">
            <%= link_to "ねえ聞いて！変な夢を見たの", root_path, class: "btn btn-ghost text-xl" %>
        </div>
        <% if user_signed_in? %>
            <div class="flex-none mr-4">
                <%= link_to "投稿", new_post_path, class: "link-hover mx-2" %>
                <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "link-hover mx-2" %>
            </div>
        <% else %>
            <div class="flex-none mr-4">
                <%= link_to "Login", new_user_session_path, class: "link-hover mx-2" %>
            </div>
        <% end %>
    </div>
</header>